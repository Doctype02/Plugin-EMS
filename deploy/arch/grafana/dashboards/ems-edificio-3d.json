{
  "apiVersion": "dashboard.grafana.app/v2beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "ems-edificio-3d-vivo"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "Gemelo digital en vivo: potencia frente a 170 kW, paneles solares, red y alarmas, y el edificio en 3D.",
    "editable": true,
    "elements": {
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Gemelo digital del edificio",
          "description": "Vista 3D del edificio de 5 plantas con el estado de cada zona, las unidades VRF/PTAC y los controles del EMS. Haz clic en una planta o zona para ver su detalle.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "ems-influx"
                      },
                      "spec": {
                        "query": "from(bucket: \"ems\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"zona\" and r.escenario == \"live\")\n  |> aggregateWindow(every: 5m, fn: last, createEmpty: false)\n  |> pivot(rowKey: [\"_time\", \"zona\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "ems-influx"
                      },
                      "spec": {
                        "query": "from(bucket: \"ems\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"medidor\" and r.escenario == \"live\")\n  |> aggregateWindow(every: 5m, fn: last, createEmpty: false)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "ems-influx"
                      },
                      "spec": {
                        "query": "from(bucket: \"ems\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"ems\" and r.escenario == \"live\")\n  |> last()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()"
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "ems-influx"
                      },
                      "spec": {
                        "query": "from(bucket: \"ems\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"alarma\" and r.escenario == \"live\")\n  |> pivot(rowKey: [\"_time\", \"zona\", \"codigo\", \"nivel\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()"
                      }
                    },
                    "refId": "D",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "ems-influx"
                      },
                      "spec": {
                        "query": "from(bucket: \"ems\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"unidad\" and r.escenario == \"live\")\n  |> last()\n  |> pivot(rowKey: [\"_time\", \"unidad\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()"
                      }
                    },
                    "refId": "E",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "doctype02-ems-panel",
            "version": "1.6.2",
            "spec": {
              "options": {
                "allowControl": true,
                "animations": true,
                "azimuth": 0,
                "controlUrl": "http://{host}:1880/ems/control",
                "defaultFloor": "auto",
                "defaultView": "status",
                "demoController": "reglas_dr",
                "demoMode": true,
                "demoSpeed": 60,
                "exploded": true,
                "limitKw": 170,
                "pvMode": "auto",
                "refreshSeconds": 2,
                "showSidebar": true,
                "showSummary": true,
                "showTimeBar": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "AutoGridLayout",
      "spec": {
        "maxColumnCount": 3,
        "columnWidthMode": "standard",
        "rowHeightMode": "standard",
        "fillScreen": true,
        "items": [
          {
            "kind": "AutoGridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "panel-5"
              }
            }
          }
        ]
      }
    },
    "links": [
