  "panels": [
    {
      "type": "gauge",
      "title": "Potencia ahora",
      "description": "Potencia que usa el edificio en este momento (mediana de los últimos 15 min). La aguja llega al rojo al acercarse al límite contratado de 170 kW.",
      "datasource": {
        "type": "influxdb",
        "uid": "ems-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "ems-influx"
          },
          "query": "from(bucket: \"ems\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"medidor\" and r.escenario == \"live\" and r._field == \"p_total_kw\")\n  // Mediana de las 3 últimas muestras (15 min): ignora el pico aislado de un reinicio del simulador\n  |> tail(n: 3)\n  |> median()\n  |> keep(columns: [\"_value\"])"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "decimals": 1,
          "min": 0,
          "max": 170,
          "noValue": "Sin datos",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 136
              },
              {
                "color": "orange",
                "value": 153
              },
              {
                "color": "red",
                "value": 170
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 28
        }
      },
      "id": 1
    },
