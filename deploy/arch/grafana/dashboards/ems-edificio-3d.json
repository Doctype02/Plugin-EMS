    {
      "type": "stat",
      "title": "Potencia actual",
      "description": "Consumo instantáneo del edificio; sparkline de las últimas 6 h. Amarillo ≥ 80 %, naranja ≥ 90 % y rojo al llegar al límite de 170 kW.",
      "datasource": {
        "type": "influxdb",
        "uid": "ems-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "ems-influx"
          },
          "query": "from(bucket: \"ems\")\n  |> range(start: -6h)\n  |> filter(fn: (r) => r._measurement == \"medidor\" and r.escenario == \"live\" and r._field == \"p_total_kw\")\n  |> aggregateWindow(every: 5m, fn: last, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sin datos",
          "color": {
            "mode": "thresholds"
          },
          "unit": "kwatt",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 136
              },
              {
                "color": "orange",
                "value": 153
              },
              {
                "color": "red",
                "value": 170
