  "panels": [
    {
      "id": 1,
      "type": "doctype02-ems-panel",
      "title": "Edificio inteligente — EMS",
      "datasource": {
        "type": "influxdb",
        "uid": "ems-influx"
      },
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "ems-influx"
          },
          "query": "from(bucket: \"ems\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"zona\" and r.escenario == \"live\")\n  |> aggregateWindow(every: 5m, fn: last, createEmpty: false)\n  |> pivot(rowKey: [\"_time\", \"zona\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "ems-influx"
          },
          "query": "from(bucket: \"ems\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"medidor\" and r.escenario == \"live\")\n  |> aggregateWindow(every: 5m, fn: last, createEmpty: false)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "influxdb",
            "uid": "ems-influx"
          },
          "query": "from(bucket: \"ems\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"ems\" and r.escenario == \"live\")\n  |> last()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "influxdb",
            "uid": "ems-influx"
          },
          "query": "from(bucket: \"ems\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"alarma\" and r.escenario == \"live\")\n  |> pivot(rowKey: [\"_time\", \"zona\", \"codigo\", \"nivel\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "influxdb",
            "uid": "ems-influx"
          },
          "query": "from(bucket: \"ems\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"unidad\" and r.escenario == \"live\")\n  |> last()\n  |> pivot(rowKey: [\"_time\", \"unidad\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()"
        }
      ],
      "options": {
        "demoMode": false,
        "limitKw": 170,
        "pvMode": "auto",
        "defaultView": "status",
        "azimuth": 0,
        "exploded": true,
        "showSummary": true,
        "showSidebar": true,
        "animations": true,
        "allowControl": true,
        "controlUrl": "http://{host}:1880/ems/control",
        "demoSpeed": 60,
        "refreshSeconds": 2
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Potencia actual",
      "description": "Consumo del edificio frente a la potencia máxima de 170 kW.",
