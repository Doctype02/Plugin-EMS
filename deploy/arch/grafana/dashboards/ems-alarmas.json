    {
      "id": 9,
      "type": "table",
      "title": "Alarmas y eventos recientes",
      "description": "Alarmas del EMS (Node-RED o supervisor del gemelo) en el rango, de la más reciente a la más antigua. Los eventos simulados (incendio, corte, falla VRF…) aparecen a través de las alarmas que provocan. Filtra por columna.",
      "datasource": {
        "type": "influxdb",
        "uid": "ems-influx"
      },
      "gridPos": {
        "h": 14,
        "w": 14,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "ems-influx"
          },
          "query": "from(bucket: \"ems\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"alarma\" and r.escenario == \"live\")\n  |> pivot(rowKey: [\"_time\", \"nivel\", \"codigo\", \"zona\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 500)\n  |> keep(columns: [\"_time\", \"nivel\", \"codigo\", \"zona\", \"mensaje\", \"valor\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": true
          },
          "noValue": "Sin alarmas en el rango"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "_time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Hora"
              },
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "nivel"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Nivel"
              },
              {
                "id": "custom.width",
                "value": 80
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "crit": {
                        "text": "CRÍTICA",
                        "color": "#F2495C",
                        "index": 0
                      },
                      "warn": {
                        "text": "AVISO",
                        "color": "#FF9830",
                        "index": 1
                      },
                      "info": {
                        "text": "INFO",
                        "color": "#5794F2",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
