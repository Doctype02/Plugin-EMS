    {
      "id": 9,
      "type": "table",
      "title": "Alarmas y eventos",
      "description": "Alarmas del EMS (Node-RED o supervisor del gemelo) en el rango, de la más reciente a la más antigua. Los eventos simulados (incendio, corte, falla VRF…) aparecen por las alarmas que provocan. Filtra por columna.",
      "datasource": {
        "type": "influxdb",
        "uid": "ems-influx"
      },
      "gridPos": {
        "h": 14,
        "w": 16,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "ems-influx"
          },
          "query": "from(bucket: \"ems\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"alarma\" and r.escenario == \"live\")\n  |> pivot(rowKey: [\"_time\", \"nivel\", \"codigo\", \"zona\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 500)\n  |> keep(columns: [\"_time\", \"nivel\", \"codigo\", \"zona\", \"mensaje\", \"valor\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": true
          },
          "noValue": "Sin alarmas en el rango"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "_time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Hora"
              },
              {
                "id": "unit",
                "value": "time:DD/MM HH:mm:ss"
              },
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "nivel"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Nivel"
              },
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "crit": {
                        "text": "● Crítica",
                        "color": "#F2495C",
                        "index": 0
                      },
                      "warn": {
                        "text": "● Aviso",
                        "color": "#FF9830",
                        "index": 1
                      },
                      "info": {
                        "text": "● Info",
                        "color": "#4C8DE6",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "codigo"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Código"
              },
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "zona"
