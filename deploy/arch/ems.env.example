# /etc/ems/ems.env — variables del contrato (docs/CONTRATO.md §1). Permisos: 640 root:ems
# systemd NO admite comentarios al final de una línea: dejar cada comentario en su propia línea.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
EMS_EDIFICIO=edificio1
# Simulador. externo = obedece a Node-RED
EMS_CONTROL=externo
# 1 = tiempo real (recomendado permanente); 60 = un día cada 24 min (grabación del video)
EMS_VELOCIDAD=1
# ahora = con velocidad 1, el tiempo simulado coincide con el reloj
EMS_INICIO=ahora
# 0 = continuo
EMS_DIAS=0
# InfluxDB 2
INFLUX_URL=http://127.0.0.1:8086
INFLUX_ORG=utp
INFLUX_BUCKET=ems
INFLUX_TOKEN=REEMPLAZAR_TOKEN_ESCRITURA
